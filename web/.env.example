# Сайтын жинхэнэ хаяг — canonical, sitemap, OG-д хэрэглэгдэнэ
NEXT_PUBLIC_SITE_URL=https://daamal.org

# --- MariaDB / MySQL (ирсэн санал энд хадгалагдана) ---------------------------
# hPanel → Databases → MySQL Databases хэсгээс үүсгээд утгыг нь буулгана.
# Нууц үгэнд тусгай тэмдэгт байж болно — URL-encode хийх шаардлагагүй.
#
# АНХААР: "localhost" гэж БИЧИХГҮЙ. mysql2 түүнийг IPv6 ::1 болгодог ба
# Hostinger-ийн эрх зөвхөн 'user'@'localhost'-д олгогддог тул татгалздаг.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Shared hosting дээр холболтын тоо хязгаартай — багаар барина
DB_POOL_MAX=3

# Хүснэгтийг үүсгэх: npm run db:setup

# --- Мэдэгдлийн имэйл (SMTP) --------------------------------------------------
# Gmail-ээр илгээх бол SMTP_PASS нь энгийн нууц үг БИШ, App password байна:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Илгээгчийн харагдах нэр (заавал биш, үндсэн нь SMTP_USER)
# SMTP_FROM="Даамал <хаяг@gmail.com>"
# Хүлээн авагч (үндсэн нь erdenebayar0930@gmail.com)
CONTACT_EMAIL_TO=erdenebayar0930@gmail.com

# --- Нэмэлт -------------------------------------------------------------------
# Сан хүрэхгүй үед санал буух нөөц файл (үндсэн нь data/offers.jsonl)
# CONTACT_STORE_PATH=data/offers.jsonl
# Slack / Discord / Google Chat webhook — заавал биш
# CONTACT_WEBHOOK_URL=
